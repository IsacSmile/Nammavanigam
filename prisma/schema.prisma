// Prisma Schema for Local Business Directory Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  user
  business_owner
  admin
}

enum UserStatus {
  active
  suspended
}

enum BusinessStatus {
  pending
  approved
  rejected
}

enum BannerStatus {
  none
  pending
  approved
  rejected
}

enum AppointmentStatus {
  pending
  handled
}


// 1. Users table
model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  businesses    Business[]
  reviews       Review[]
  reviewReports ReviewReport[]

  @@map("users")
}

// 2. Categories table (Self-referencing tree structure)
model Category {
  id          Int     @id @default(autoincrement())
  parentId    Int?    @map("parent_id")
  name        String
  slug        String  @unique
  iconUrl     String? @map("icon_url")
  description String?
  status      String  @default("active")
  sortOrder   Int     @default(0) @map("sort_order")

  // Relations
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")
  businesses Business[]

  @@index([parentId])
  @@map("categories")
}

// 3. Locations table (Self-referencing tree structure)
model Location {
  id        Int    @id @default(autoincrement())
  parentId  Int?   @map("parent_id")
  name      String
  slug      String @unique
  latitude  Float?
  longitude Float?
  status    String @default("active")
  sortOrder Int    @default(0) @map("sort_order")

  // Relations
  parent     Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Location[] @relation("LocationHierarchy")
  businesses Business[]

  @@index([parentId])
  @@map("locations")
}

// 4. Businesses table
model Business {
  id          Int            @id @default(autoincrement())
  ownerId     Int            @map("owner_id")
  name        String
  slug        String         @unique
  categoryId  Int            @map("category_id")
  locationId  Int            @map("location_id")
  description String?        @db.Text
  address     String?
  latitude    Float?
  longitude   Float?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  status                BusinessStatus @default(pending)
  rejectionReason       String?        @map("rejection_reason") @db.Text
  verified              Boolean        @default(false)
  featured              Boolean        @default(false)
  showcaseOrder         Int?           @map("showcase_order")
  bannerUrl             String?        @map("banner_url")
  bannerPendingUrl      String?        @map("banner_pending_url")
  bannerStatus          BannerStatus   @default(none) @map("banner_status")
  bannerRejectionReason String?        @map("banner_rejection_reason") @db.Text
  bannerSubmittedAt     DateTime?      @map("banner_submitted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relations
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  businessServices    BusinessService[]
  businessPhotos      BusinessPhoto[]
  businessHours       BusinessHour[]
  businessPhones      BusinessPhone[]
  businessSocialLinks BusinessSocialLink[]
  reviews             Review[]

  @@index([categoryId])
  @@index([locationId])
  @@index([ownerId])
  @@index([status])
  @@map("businesses")
}

// 5. Business Services table
model BusinessService {
  id          Int      @id @default(autoincrement())
  businessId  Int      @map("business_id")
  serviceName String   @map("service_name")
  description String?
  price       Decimal? @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_services")
}

// 6. Business Photos table
model BusinessPhoto {
  id         Int     @id @default(autoincrement())
  businessId Int     @map("business_id")
  imageUrl   String  @map("image_url")
  altText    String? @map("alt_text")
  sortOrder  Int     @default(0) @map("sort_order")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_photos")
}

// 7. Business Hours table
model BusinessHour {
  id          Int     @id @default(autoincrement())
  businessId  Int     @map("business_id")
  day         String
  openingTime String? @map("opening_time")
  closingTime String? @map("closing_time")
  closed      Boolean @default(false)

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_hours")
}

// 8. Reviews table
model Review {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  userId     Int      @map("user_id")
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  ReviewReport[]

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("reviews")
}

// 9. Review Reports table
model ReviewReport {
  id         Int      @id @default(autoincrement())
  reviewId   Int      @map("review_id")
  reportedBy Int      @map("reported_by")
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  @@unique([reviewId, reportedBy])
  @@index([reviewId])
  @@index([reportedBy])
  @@map("review_reports")
}

// 10. Business Phones table
model BusinessPhone {
  id         Int     @id @default(autoincrement())
  businessId Int     @map("business_id")
  number     String
  label      String?
  sortOrder  Int     @default(0) @map("sort_order")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_phones")
}

// 11. Business Social Links table
model BusinessSocialLink {
  id         Int    @id @default(autoincrement())
  businessId Int    @map("business_id")
  platform   String
  url        String

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
  @@index([businessId])
  @@map("business_social_links")
}

// 12. Appointments table
model Appointment {
  id              Int               @id @default(autoincrement())
  name            String
  phone           String
  appointmentDate String            @map("appointment_date")
  appointmentTime String            @map("appointment_time")
  message         String?           @db.Text
  status          AppointmentStatus @default(pending)
  ipHash          String?           @map("ip_hash")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([phone, createdAt])
  @@map("appointments")
}



